{
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/ai-catalog.json",
      "destination": "/ai-catalog.json"
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "/.well-known/ai-catalog.json"
    },
    {
      "source": "/.well-known/ard.json",
      "destination": "/.well-known/ard.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ai-catalog+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ai-catalog+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ai-catalog+json; charset=utf-8"
        }
      ]
    }
  ]
}
